# 本地 Mock 配置示例。请通过系统环境变量或部署平台密钥配置注入实际值。
SPRING_PROFILES_ACTIVE=mock
APP_MODE=mock
SERVER_PORT=8080

# 当前使用确定性 Mock 规则评分；真实模型阶段替换为内部 Reviewer 适配器。
CASE_REVIEW_MODE=mock

# 默认 openai；内网官方框架构建时由 finxscope profile 使用 finxscope。
MODEL_TRANSPORT=openai

# 知识问答默认使用确定性 Mock；openai 仅用于通用兼容层开发验证，不代表已接入正式 Fin-X-Scope。
KNOWLEDGE_ANSWER_MODE=mock

# Mock H2 可保持默认值；不要在此文件写入真实凭据。
MOCK_DB_URL=jdbc:h2:file:./data/custody-training;MODE=MySQL;AUTO_SERVER=TRUE
MOCK_DB_USERNAME=<本地数据库用户名>
MOCK_DB_PASSWORD=<本地数据库密码>

# internal 配置使用托管关系型数据库。
DB_URL=<部署平台注入的数据库地址>
DB_USERNAME=<部署平台注入的数据库用户名>
DB_PASSWORD=<部署平台注入的数据库密码>
DB_DRIVER=<部署平台注入的数据库驱动类名>

# OpenAI 兼容模型配置。仅在 CASE_REVIEW_MODE=openai 或基准脚本中使用。
MODEL_BASE_URL=<部署平台注入的模型网关地址>
MODEL_CHAT_PATH=/chat/completions
MODEL_API_KEY=<部署平台注入的模型鉴权信息>
MODEL_NAME=<部署平台注入的模型名称>
# 公共 API 通常保持 false；内网模型网关按接入文档要求设为 true。不要填写真实员工号。
MODEL_SEND_USER_ID_HEADER=false
MODEL_CONNECT_TIMEOUT=3s
MODEL_REVIEW_TIME_BUDGET=15s
MODEL_MAX_TOKENS=3000
MODEL_TEMPERATURE=0.1
MODEL_MAX_REPAIR_ATTEMPTS=1
# 通用默认 omit；DeepSeek 官方时延基准可设 disabled，内网网关确认支持前保持 omit。
MODEL_THINKING_MODE=omit

# Fin-X-Scope 内网 profile 可选配置，不要在默认 Mock 环境填写。
FINXSCOPE_AGENT_NAME=custody_training_agent
FINXSCOPE_EXECUTOR_THREADS=4

# 基准次数。只使用合成占位案例和合成答案。
MODEL_BENCHMARK_RUNS=3

# internal 启动账号：仅在部署平台密钥配置中填写，不能提交真实值。
BOOTSTRAP_USER1_EMPLOYEE_NO=<比赛账号1员工号>
BOOTSTRAP_USER1_DISPLAY_NAME=<比赛账号1显示名>
BOOTSTRAP_USER1_PASSWORD=<比赛账号1初始密码>
BOOTSTRAP_USER2_EMPLOYEE_NO=<比赛账号2员工号>
BOOTSTRAP_USER2_DISPLAY_NAME=<比赛账号2显示名>
BOOTSTRAP_USER2_PASSWORD=<比赛账号2初始密码>

# internal 默认启用 Secure Cookie；本地 HTTP Mock 默认关闭。
SESSION_COOKIE_SECURE=<true 或 false>
