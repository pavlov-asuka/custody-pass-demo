{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custody-training.local/schemas/route.schema.json",
  "title": "路线公开学习内容",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeId", "contentVersion", "line", "title", "summary", "objectives", "steps", "references"],
  "properties": {
    "routeId": {"type": "string"},
    "contentVersion": {"type": "string"},
    "line": {"enum": ["CLEARING", "ACCOUNTING", "SUPERVISION"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["KNOWLEDGE_CARD", "DEMONSTRATION", "BASIC_PRACTICE", "COMPREHENSIVE_PRACTICE"],
      "properties": {
        "KNOWLEDGE_CARD": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cards"],
          "properties": {
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cardId", "type", "title", "conclusion", "items"],
                "properties": {
                  "cardId": {"type": "string"},
                  "type": {"enum": ["FLOW", "CATEGORIES", "KEY_POINT"]},
                  "title": {"type": "string"},
                  "conclusion": {"type": "string"},
                  "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "DEMONSTRATION": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario", "steps", "summary"],
          "properties": {
            "scenario": {"type": "object"},
            "steps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order", "action", "reason"],
                "properties": {
                  "order": {"type": "integer", "minimum": 1},
                  "action": {"type": "string"},
                  "reason": {"type": "string"}
                }
              }
            },
            "summary": {"type": "string"}
          }
        },
        "BASIC_PRACTICE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions"],
          "properties": {
            "questions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["questionId", "type", "prompt", "answer", "explanation", "hints"],
                "properties": {
                  "questionId": {"type": "string"},
                  "type": {"enum": ["SINGLE_CHOICE", "MULTIPLE_CHOICE", "ORDERING", "FIELD_MAP", "CALCULATION", "LEDGER_ENTRY", "RECONCILIATION", "SHORT_TEXT"]},
                  "prompt": {"type": "string"},
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["optionId", "text"],
                      "properties": {
                        "optionId": {"type": "string"},
                        "text": {"type": "string"}
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["itemId", "text"],
                      "properties": {
                        "itemId": {"type": "string"},
                        "text": {"type": "string"}
                      }
                    }
                  },
                  "fieldMappings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["fieldId", "label", "source", "options"],
                      "properties": {
                        "fieldId": {"type": "string"},
                        "label": {"type": "string"},
                        "source": {"type": "string"},
                        "options": {
                          "type": "array",
                          "minItems": 2,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["optionId", "text"],
                            "properties": {
                              "optionId": {"type": "string"},
                              "text": {"type": "string"}
                            }
                          }
                        }
                      }
                    }
                  },
                  "calculation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fields"],
                    "properties": {
                      "fields": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["fieldId", "label", "formula", "placeholder", "unit"],
                            "properties": {
                              "fieldId": {"type": "string"},
                              "label": {"type": "string"},
                              "formula": {"type": "string"},
                              "placeholder": {"type": "string"},
                              "unit": {"type": "string"},
                              "precision": {"type": "integer", "minimum": 0, "maximum": 8},
                              "tolerance": {"type": "number", "minimum": 0}
                          }
                        }
                      }
                    }
                  },
                  "ledgerEntries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["entryId", "direction", "label", "amount", "placeholder"],
                      "properties": {
                        "entryId": {"type": "string"},
                        "direction": {"type": "string"},
                        "label": {"type": "string"},
                        "amount": {"type": "string"},
                        "placeholder": {"type": "string"}
                      }
                    }
                  },
                  "reconciliation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fields"],
                    "properties": {
                      "fields": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["fieldId", "label", "kind", "formula", "placeholder"],
                          "properties": {
                            "fieldId": {"type": "string"},
                            "label": {"type": "string"},
                            "kind": {"enum": ["NUMBER", "SELECT"]},
                            "formula": {"type": "string"},
                            "placeholder": {"type": "string"},
                            "precision": {"type": "integer", "minimum": 0, "maximum": 8},
                            "tolerance": {"type": "number", "minimum": 0},
                            "options": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["optionId", "text"],
                                "properties": {
                                  "optionId": {"type": "string"},
                                  "text": {"type": "string"}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "textInput": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "placeholder"],
                    "properties": {
                      "label": {"type": "string"},
                      "placeholder": {"type": "string"}
                    }
                  },
                  "answer": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "explanation": {"type": "string"},
                  "hints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "COMPREHENSIVE_PRACTICE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario", "sourceMaterials", "workItems", "submissionNote"],
          "properties": {
            "scenario": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "product", "date", "purpose"],
              "properties": {
                "role": {"type": "string"},
                "product": {"type": "string"},
                "date": {"type": "string"},
                "purpose": {"type": "string"}
              }
            },
            "sourceMaterials": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["materialId", "title", "kind", "description", "fields"],
                "properties": {
                  "materialId": {"type": "string"},
                  "title": {"type": "string"},
                  "kind": {"enum": ["INSTRUCTION", "CONFIRMATION", "STATEMENT", "PARAMETER", "VOUCHER", "LEDGER", "VALUATION", "REPORT", "RECONCILIATION"]},
                  "description": {"type": "string"},
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["fieldId", "label", "value"],
                      "properties": {
                        "fieldId": {"type": "string"},
                        "label": {"type": "string"},
                        "value": {"type": "string"},
                        "unit": {"type": "string"}
                      }
                    }
                  }
                }
              }
            },
            "workItems": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workItemId", "type", "title", "instruction", "response"],
                "properties": {
                  "workItemId": {"type": "string"},
                  "type": {"enum": ["FIELD_MAP", "CALCULATION", "LEDGER_ENTRY", "RECONCILIATION", "SHORT_TEXT"]},
                  "title": {"type": "string"},
                  "instruction": {"type": "string"},
                  "response": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "placeholder"],
                    "properties": {
                      "kind": {"enum": ["TEXT", "NUMBER", "SELECT"]},
                      "placeholder": {"type": "string"},
                      "unit": {"type": "string"},
                      "precision": {"type": "integer", "minimum": 0, "maximum": 8},
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["optionId", "text"],
                          "properties": {
                            "optionId": {"type": "string"},
                            "text": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "submissionNote": {"type": "string"}
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceId", "title", "source", "usage"],
        "properties": {
          "referenceId": {"type": "string"},
          "title": {"type": "string"},
          "source": {"type": "string"},
          "usage": {"type": "string"}
        }
      }
    }
  }
}
