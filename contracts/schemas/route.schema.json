{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custody-training.local/schemas/route.schema.json",
  "title": "路线公开学习内容",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeId", "contentVersion", "line", "title", "summary", "objectives", "steps", "references"],
  "properties": {
    "routeId": {"type": "string"},
    "contentVersion": {"type": "string"},
    "line": {"enum": ["CLEARING", "ACCOUNTING", "SUPERVISION"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "estimatedMinutes": {"type": "integer", "minimum": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["KNOWLEDGE_CARD", "DEMONSTRATION", "BASIC_PRACTICE", "EXCEPTION_CASE"],
      "properties": {
        "KNOWLEDGE_CARD": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cards"],
          "properties": {
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cardId", "type", "title", "conclusion", "items"],
                "properties": {
                  "cardId": {"type": "string"},
                  "type": {"enum": ["FLOW", "CATEGORIES", "KEY_POINT"]},
                  "title": {"type": "string"},
                  "conclusion": {"type": "string"},
                  "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "DEMONSTRATION": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario", "steps", "summary"],
          "properties": {
            "scenario": {"type": "object"},
            "steps": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order", "action", "reason"],
                "properties": {
                  "order": {"type": "integer", "minimum": 1},
                  "action": {"type": "string"},
                  "reason": {"type": "string"}
                }
              }
            },
            "summary": {"type": "string"}
          }
        },
        "BASIC_PRACTICE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions"],
          "properties": {
            "questions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["questionId", "type", "prompt", "answer", "explanation", "hints"],
                "properties": {
                  "questionId": {"type": "string"},
                  "type": {"enum": ["SINGLE_CHOICE", "MULTIPLE_CHOICE", "ORDERING"]},
                  "prompt": {"type": "string"},
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["optionId", "text"],
                      "properties": {
                        "optionId": {"type": "string"},
                        "text": {"type": "string"}
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["itemId", "text"],
                      "properties": {
                        "itemId": {"type": "string"},
                        "text": {"type": "string"}
                      }
                    }
                  },
                  "answer": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "explanation": {"type": "string"},
                  "hints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "EXCEPTION_CASE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario", "tasks", "writingPrompts"],
          "properties": {
            "scenario": {"type": "object"},
            "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "writingPrompts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceId", "title", "source", "usage"],
        "properties": {
          "referenceId": {"type": "string"},
          "title": {"type": "string"},
          "source": {"type": "string"},
          "usage": {"type": "string"}
        }
      }
    }
  }
}
