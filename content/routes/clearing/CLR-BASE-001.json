{
  "routeId": "CLR-BASE-001",
  "contentVersion": "1.0.0",
  "line": "CLEARING",
  "title": "清算义务对象与结果核对",
  "summary": "围绕同一 SETTLEMENT_OBLIGATION，读取指令、确认/成交、交收结果和对账资料，用业务键、业务日期、方向、数量或金额把结果核对到零差。",
  "estimatedMinutes": 55,
  "objectives": [
    "从指令、确认/成交、交收结果和对账资料中定位 SETTLEMENT_OBLIGATION 的业务键、业务日期、资产类型和方向",
    "读取数量、金额、单位和参与角色，把同一笔义务的来源字段放到对应工作纸",
    "按本案例给定的批次数量与单位数量、金额分项独立复算数量和金额",
    "按业务键、业务日期和方向对应结果，确认数量差与金额差均为零后记录正常结果状态"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "CLR-BASE-KC-01",
          "type": "CATEGORIES",
          "title": "四份资料，各自回答一个问题",
          "conclusion": "指令说明要处理什么，确认/成交资料说明双方确认了什么，交收结果说明实际完成了什么，对账资料说明结果能否对上。",
          "items": [
            "指令资料提供业务键、业务日期、资产类型、方向、数量或金额和参与角色",
            "确认/成交资料承接同一业务键，确认交易或业务关系及对应数量、金额",
            "交收结果资料记录实际数量、金额和结果状态",
            "对账资料把预期值与结果值按业务键、日期和方向放在一起比较"
          ]
        },
        {
          "cardId": "CLR-BASE-KC-02",
          "type": "FLOW",
          "title": "把一笔义务串成可核对记录",
          "conclusion": "SETTLEMENT_OBLIGATION 不是资料标题，而是由身份字段、处理字段、参与角色和结果字段共同组成的业务对象。",
          "items": [
            "用业务键、业务日期和方向把四份资料归到同一笔义务",
            "把资产类型、数量、金额和单位从对应来源读入工作纸",
            "把交收双方和复核方保留为参与角色，不用资料来源名称代替角色",
            "把确认、交收和对账结果按来源顺序放回同一笔义务"
          ]
        },
        {
          "cardId": "CLR-BASE-KC-03",
          "type": "KEY_POINT",
          "title": "结果要对得上，才算完成",
          "conclusion": "同一业务键、日期和方向下，数量差与金额差都为零，且结果状态为本案例的正常完成状态，记录才可以结束。",
          "items": [
            "数量按单位保留本案例要求的整数精度，金额按本案例要求保留两位小数",
            "比较时同时保留业务键、业务日期和方向，不能只看金额或数量",
            "交收结果的参与角色与确认资料中的角色关系要能对应",
            "对账资料中的数量差和金额差分别为0和0.00"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "清算资料处理岗",
        "product": "单一正常 SETTLEMENT_OBLIGATION 教学案例",
        "date": "2026-08-18",
        "fixture": "CLR-BASE-DEMO-A",
        "facts": [
          "指令资料的业务键为BASE-A-20260818-017，业务日期为2026-08-18，资产类型为SECURITY，方向为RECEIVE，数量为2400 unit，金额为18750.00 CNY。",
          "指令资料给出12个批次、每批200 unit；交付方、接收方和复核方分别为DELIVERING_PARTICIPANT、RECEIVING_PARTICIPANT、RECONCILIATION_REVIEWER。",
          "确认/成交资料承接同一业务键、日期、资产类型和方向，确认数量2400 unit、金额18750.00 CNY；交收结果记录同样数量和金额，结果状态为SETTLED。",
          "对账资料将预期数量2400与结果数量2400、预期金额18750.00与结果金额18750.00放在同一业务键下，数量差为0、金额差为0.00，状态为RECONCILED。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "从指令资料读取业务键BASE-A-20260818-017、业务日期2026-08-18、资产类型SECURITY和方向RECEIVE，并建立SETTLEMENT_OBLIGATION记录",
          "reason": "业务键、日期和方向是四份资料归并到同一笔义务的身份字段。"
        },
        {
          "order": 2,
          "action": "把确认/成交资料的数量2400 unit、金额18750.00 CNY和参与角色与指令记录逐项对应",
          "reason": "确认资料要承接同一身份字段，数量、金额、单位和角色才能进入后续结果核对。"
        },
        {
          "order": 3,
          "action": "按12×200计算数量2400，按7250.00+11500.00计算金额18750.00，并按本案例精度保存",
          "reason": "独立复算把资料中的分项数字变成可以与确认和交收结果比较的工作纸值。"
        },
        {
          "order": 4,
          "action": "把交收结果的SETTLED状态、数量2400 unit和金额18750.00 CNY登记到同一业务键的结果栏",
          "reason": "结果栏只承接交收结果资料，不用指令或确认状态代替实际结果。"
        },
        {
          "order": 5,
          "action": "按业务键、日期和RECEIVE方向比较预期与结果，确认数量差0、金额差0.00并记录RECONCILED",
          "reason": "身份字段一致且两类数值差为零，才有足够证据记录本案例的正常结果。"
        }
      ],
      "summary": "业务身份 → 来源字段 → 数量/金额复算 → 交收结果 → 零差核对"
    },
