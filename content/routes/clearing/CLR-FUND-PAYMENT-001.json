{
  "routeId": "CLR-FUND-PAYMENT-001",
  "contentVersion": "1.0.0",
  "line": "CLEARING",
  "title": "资金指令审核与正常支付执行",
  "summary": "围绕一笔正常资金支付指令，核对业务依据、收付款账户、账户状态与锁定、支付日期和批准渠道，登记执行结果并把资金账余额接续到零差。",
  "estimatedMinutes": 60,
  "objectives": [
    "从支付指令和业务依据中定位业务键、业务日期、支付金额、收付款账户及业务关系",
    "按这笔业务资料核对收付款账户状态与锁定、支付日期和批准渠道，再承接正常执行结果",
    "用 Decimal 字符串复算期初现金 - 批准支付金额 = 期末现金，并核对指令、执行和资金账变动金额一致",
    "按业务键、业务日期、账户、业务依据、渠道和状态完成跨来源勾稽，记录差额为零的正常结果"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "CLR-FUND-PAYMENT-KC-01",
          "type": "CATEGORIES",
          "title": "指令和业务依据要放在同一张工作纸上",
          "conclusion": "指令告诉你要支付什么，业务依据说明这笔支付对应的业务关系；金额、日期和账户必须能相互对应。",
          "items": [
            "从指令读取业务键、支付金额、付款账户、收款账户和支付日期",
            "从业务依据读取业务依据编号、业务类型、依据状态和批准金额",
            "把业务依据与指令按业务键、日期、账户组合和金额逐项对应",
            "金额和身份字段都来自资料，不用支付结果倒推审核结论"
          ]
        },
        {
          "cardId": "CLR-FUND-PAYMENT-KC-02",
          "type": "FLOW",
          "title": "先审核字段，再承接执行结果",
          "conclusion": "收付款账户状态与锁定、支付日期和批准渠道都与指令及依据一致，才可以把正常执行结果登记回同一业务键。",
          "items": [
            "分别核对付款账户和收款账户的状态、锁定字段及账户组合",
            "核对业务日期与支付日期，并确认业务依据处于这笔业务批准状态",
            "把资料中的批准渠道与执行结果渠道逐项对应",
            "执行结果保留执行日期、执行金额和正常执行状态"
          ]
        },
        {
          "cardId": "CLR-FUND-PAYMENT-KC-03",
          "type": "KEY_POINT",
          "title": "支付结果要接到账上",
          "conclusion": "正常支付完成后，批准支付金额、执行金额和资金账支付变动三个金额相等，期初现金减去支付金额等于期末现金，且两类差额均为零。",
          "items": [
            "用期初现金 - 批准支付金额独立计算期末现金，金额保留两位小数",
            "分别比较指令金额、执行金额和资金账支付变动金额",
            "资金账登记同一业务键、业务日期、账户组合、渠道和结果状态",
            "跨来源核对账户、依据、日期、渠道、状态和金额后再记录正常对账结果"
          ]
        }
      ]
    },
