{
  "routeId": "ACC-ED-QUARTERLY-004",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "季度报告 3.1/3.2 与指定字段复核",
  "summary": "在季度定期报告资料快照内，先锁定报告期间、模板、来源和复核时点；再读取并复算 3.1、3.2，核对管理人报告/投资组合指定字段，将结果写入底稿并确认归档状态。",
  "estimatedMinutes": 65,
  "objectives": [
    "从季度任务控制卡、批准模板和来源快照读取报告类型、期间、截止日、模板版本和复核时点",
    "独立复算 3.1 的利润拆分、加权平均份额利润和期末单位净值，并与基金概况字段勾稽",
    "独立复算 3.2 净值增长率、同期业绩比较基准收益率和超额结果，核对管理人报告、投资组合指定字段及底稿状态",
    "区分业务资料与截图中的异常列表/重签边界；签名、权限、发送和归档话术不代替复核结果"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ED-QUARTERLY-KC-01",
          "type": "FLOW",
          "title": "先锁定季度任务和来源快照",
          "conclusion": "先统一季度报告类型、期间、财务截止日、披露日期、复核日期、批准模板和来源状态，再读取数值和文字字段。",
          "items": [
            "确认季度报告以及期间起止日",
            "确认财务截止日、披露日期和复核日期的相互关系",
            "记录批准的模板/XBRL 字段版本和来源快照",
            "不把 D 日后重签、权限和历史操作时点固化为永久规则"
          ]
        },
        {
          "cardId": "ED-QUARTERLY-KC-02",
          "type": "CATEGORIES",
          "title": "3.1 与指定字段要回到原始资料",
          "conclusion": "3.1 主要财务指标必须由利润、份额、净资产和净值字段计算；重要提示、基金概况、管理人报告和投资组合指定字段要逐项读取并保留来源。",
          "items": [
            "已实现收益和未实现/公允价值变动合计为本期利润",
            "本期利润 ÷ 加权平均份额得到加权平均基金份额本期利润",
            "期末净资产 ÷ 期末份额得到期末单位净值",
            "托管人、报告期间、基金概况、管理人报告和前十名证券声明分别取数"
          ]
        },
        {
          "cardId": "ED-QUARTERLY-KC-03",
          "type": "KEY_POINT",
          "title": "3.2 复算结果与截图边界分开",
          "conclusion": "净值增长率按期初净值、期末净值和批准分红口径复算，再与报告/基准字段核对；截图异常或不符列表只证明界面字段存在，不作为资料输入。",
          "items": [
            "净值增长率 =（期末单位净值 + 批准的每份分红）÷ 期初单位净值 - 1",
            "同期业绩比较基准收益率和超额结果按批准快照字段复核",
            "截图不可靠的细小文字不补造成正式字段或公式",
            "这组资料不包含异常差异、重签或升级处理"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "栖禾季度基金的定期报告复核人员",
        "product": "栖禾季度基金（示范合成产品）",
        "date": "2026-03-31",
        "purpose": "从另一套季度资料读取任务控制和指定字段，复算 3.1/3.2，并把结果写入底稿。",
        "facts": [
          "报告为 2026 年第一季度，期间 2026-01-01 至 2026-03-31，批准复核日期 2026-04-18，披露日期 2026-04-21。",
          "已实现收益 1,200,000.00 元，未实现收益 300,000.00 元，本期利润 1,500,000.00 元；加权平均份额 75,000,000 份。",
          "期末净资产 82,000,000.00 元，期末份额 80,000,000 份，期末单位净值 1.025000，批准每份分红 0.005000 元。",
          "净值增长率 = (1.025000 + 0.005000) ÷ 1.000000 - 1 = 0.030000；基准收益率 0.018000；超额结果 0.012000。",
          "管理人报告、前十名证券声明、托管人相关信息和主管复核状态均一致。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "在控制卡记录季度类型、2026-01-01 至 2026-03-31、批准模板/来源快照，并确认复核日期 2026-04-18 早于披露日期 2026-04-21",
          "reason": "对象、期间、模板和批准时点一致后，数字和文字字段才可进入同一份底稿。"
        },
        {
          "order": 2,
          "action": "读取重要提示、基金概况和指定字段：托管人、期间、基金简称、主代码、合同生效日和期末份额",
          "reason": "季度复核既包含数字也包含指定文字字段，不能只看 3.1/3.2。"
        },
        {
          "order": 3,
          "action": "计算 3.1：1,200,000 + 300,000 = 1,500,000；1,500,000 ÷ 75,000,000 = 0.020000；82,000,000 ÷ 80,000,000 = 1.025000",
          "reason": "本期利润、加权平均份额利润和期末净值需要独立数值链，而不是抄表内结果。"
        },
        {
          "order": 4,
          "action": "计算 3.2：(1.025000 + 0.005000) ÷ 1.000000 - 1 = 0.030000；与基准 0.018000 勾稽，超额结果为 0.012000",
          "reason": "批准分红口径必须与期末净值、期初净值和报告期间一致。"
        },
        {
          "order": 5,
          "action": "把 3.1/3.2 公式和指定字段填入底稿，核对管理人/投资组合字段，并确认主管已复核、已归档",
          "reason": "结论要由数值、指定字段和复核状态共同支持，不以签送或升级动作代替业务结果。"
        }
      ],
      "summary": "锁定季度控制卡 → 读取指定字段 → 复算 3.1 → 复算 3.2 → 写入底稿并确认复核/归档"
    },
