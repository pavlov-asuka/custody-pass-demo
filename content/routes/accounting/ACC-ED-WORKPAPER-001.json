{
  "routeId": "ACC-ED-WORKPAPER-001",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "年报/中报任务口径与 3.1/3.2 计算底稿",
  "summary": "在批准的年报/中报资料快照内，先锁定报告类型、期间、截止日、版本和来源，再完成 3.1 取数、3.2 净值表现计算与复算，并把公式、来源和差额写入工作底稿。",
  "estimatedMinutes": 55,
  "objectives": [
    "从任务说明、报告资料和版本快照读取报告类型、期间、截止日及来源，不把历史模板字段当成永久规则",
    "拆分本期利润的已实现与未实现部分，复算可供分配份额利润和净值增长率，并保留公式与精度",
    "用利润、份额、净值表现和来源状态写出数字、期间和证据边界清楚的短结论"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ED-WORKPAPER-KC-01",
          "type": "FLOW",
          "title": "先锁定任务口径和来源快照",
          "conclusion": "报告类型、报告期间、财务截止日、净值表现期间、模板/XBRL 版本和来源状态必须先一致，之后的数字才可进入同一张复核底稿。",
          "items": [
            "确认年报或中报以及本期起止日",
            "分别记录财务截止日和净值表现截止日",
            "记录批准的模板、XBRL 字段和来源快照",
            "不把历史时点、字段名或审批话术泛化为永久规则"
          ]
        },
        {
          "cardId": "ED-WORKPAPER-KC-02",
          "type": "CATEGORIES",
          "title": "3.1 先拆利润再取分配口径",
          "conclusion": "本期利润总额要能由已实现和未实现部分重算；可供分配额、累计未分配利润和份额必须分别取数。",
          "items": [
            "已实现利润与公允价值变动形成的未实现部分分开读取",
            "本期利润等于两部分合计并与利润表结果勾稽",
            "可供分配额按批准口径取已实现可分配部分与期末未分配利润的较小值",
            "份额单位和金额单位不能混用"
          ]
        },
        {
          "cardId": "ED-WORKPAPER-KC-03",
          "type": "KEY_POINT",
          "title": "3.2 净值表现要复算并保留证据边界",
          "conclusion": "期末单位净值和净值增长率必须从期末净资产、期末份额和批准的期初基准复算；周边文字不足以构成标准差正式公式时，不得补造。",
          "items": [
            "期末单位净值 = 期末净资产 ÷ 期末份额",
            "无分红、拆分时，净值增长率 = 期末净值 ÷ 期初净值 - 1",
            "结果按批准精度记录，并保留未舍入计算链",
            "标准差仅在完整对象和公式证据可恢复时才进入正式答案"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "晴川基金的年报/中报复核人员",
        "product": "晴川基金（示范合成产品）",
        "date": "2026-06-30",
        "purpose": "用一组与综合实务不同的正常资料完成任务控制、3.1 利润取数和 3.2 净值表现底稿。",
        "facts": [
          "中报期间为 2026-01-01 至 2026-06-30，期末份额 51,000,000 份。",
          "已实现利润 1,200,000.00 元，未实现利润 800,000.00 元，本期利润 2,000,000.00 元。",
          "期末净资产 53,000,000.00 元，期末单位净值 1.039215686275，期初单位净值 1.000000。",
          "期末可供分配额 1,500,000.00 元，无分红、拆分；结果保留 6 位小数。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "在任务控制卡记录中报、2026-01-01 至 2026-06-30、财务和表现截止日 2026-06-30 以及 APPROVED_SNAPSHOT 来源状态",
          "reason": "先锁定对象和期间，避免把前期或其他版本数字带入底稿。"
        },
        {
          "order": 2,
          "action": "计算已实现利润 1,200,000 + 未实现利润 800,000 = 本期利润 2,000,000 元",
          "reason": "两项利润相加应等于利润表本期利润 2,000,000 元。"
        },
        {
          "order": 3,
          "action": "计算可供分配份额利润 1,500,000 ÷ 51,000,000 = 0.0294117647，按 6 位小数记录 0.029412",
          "reason": "分配额和期末份额是不同字段，不能直接抄报表显示结果。"
        },
        {
          "order": 4,
          "action": "计算净值增长率 1.039215686275 ÷ 1.000000 - 1 = 0.039215686275，按 6 位小数记录 0.039216",
          "reason": "没有分红和拆分时，按批准的期初基准复算增长率。"
        },
        {
          "order": 5,
          "action": "在底稿结论中列出利润拆分、分配份额利润和净值增长率，并把标准差标记为 EXCLUDED_BY_EVIDENCE",
          "reason": "结论必须同时说明算得出的结果和没有充分对象证据的边界。"
        }
      ],
      "summary": "锁定任务口径 → 3.1 利润拆分 → 分配份额利润复算 → 3.2 净值增长率复算 → 写入带证据边界的底稿结论"
    },
