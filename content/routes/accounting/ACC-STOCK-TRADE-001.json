{
  "routeId": "ACC-STOCK-TRADE-001",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "股票买卖与成本闭环",
  "summary": "沿同一只股票的正常买入、卖出、费用、移动加权成本、资金与估值结果完成一条可复核的核算链。",
  "estimatedMinutes": 45,
  "objectives": [
    "从成交清算日报读取成交数量、实际清算金额、费用和记录状态，判断正常买卖方向",
    "按题面批准参数将成交金额、交易费用、席位佣金分别落到买入凭证，并区分交易日确认与后续支付",
    "按卖出前成本余额与持仓数量的移动加权关系计算结转成本、估值增值和剩余持仓",
    "用资金台账、持仓台账和估值结果完成交叉勾稽并形成简短结论"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "STK-TRADE-KC-01",
          "type": "FLOW",
          "title": "一笔股票买卖怎样形成核算结果",
          "conclusion": "先读成交清算记录，再分开处理成交金额、交易费用和席位佣金，最后把持仓、成本、资金和估值结果放回同一条链核对。",
          "items": [
            "成交清算日报：成交数量、成交金额、实际清算金额和记录状态",
            "费用与佣金：交易费用来自交易清算资料，席位佣金按已批准方案形成应付",
            "买入与卖出：买入增加数量并形成成本，卖出按卖出前余额计算结转成本",
            "结果验证：剩余持仓、剩余成本、资金余额和估值表必须能互相解释"
          ]
        },
        {
          "cardId": "STK-TRADE-KC-02",
          "type": "CATEGORIES",
          "title": "成交清算记录中的字段各自证明什么",
          "conclusion": "证券数量和资金方向共同说明交易方向；成交金额、交易费用、席位佣金和实际清算金额不能互相替代。",
          "items": [
            "成交数量为正表示证券数量增加，为负表示证券数量减少",
            "实际清算金额为负表示资金流出，为正表示资金流入",
            "成交金额形成股票成本，交易费用单独处理，席位佣金在交易日确认并形成应付佣金",
            "记录状态正常只是继续处理的前提，不能用方向判断替代状态核对"
          ]
        },
        {
          "cardId": "STK-TRADE-KC-03",
          "type": "KEY_POINT",
          "title": "卖出成本要从原有持仓中结转",
          "conclusion": "卖出成交金额是本次取得的资金，不是本次卖出的历史成本；成本和估值增值都要按卖出前余额与数量的比例结转。",
          "items": [
            "单位持仓成本 = 卖出前股票成本余额 ÷ 卖出前持仓数量",
            "卖出结转成本 = 单位持仓成本 × 本次卖出数量",
            "剩余持仓 = 卖出前持仓 - 卖出数量；剩余成本 = 卖出前成本 - 结转成本",
            "卖出后还要用资金台账和估值结果复算，不把历史成本、卖出金额和市值混为一项"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "案例产品 A 的组合核算人员",
        "product": "案例产品 A / 案例股份 A",
        "date": "2026-07-11 至 2026-07-12",
        "facts": [
          "7 月 10 日收盘持有 20,000 股，股票成本余额 180,000 元，估值增值余额 20,000 元。",
          "7 月 10 日处理前资金台账余额为 1,000,000 元。",
          "7 月 11 日记录状态正常，买入 10,000 股，成交金额 100,000 元，交易费用 120 元，席位佣金 80 元，实际清算金额 -100,040 元。",
          "买入后日终持仓为 30,000 股，成本余额 280,000 元，收盘价 10.50 元，估值增值余额 35,000 元。",
          "7 月 12 日正常卖出 12,000 股，成交金额 132,000 元，交易费用 100 元，席位佣金 90 元，实际清算金额 +131,900 元。",
          "7 月 12 日估值日收盘价为 11.00 元/股。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "读取两日成交清算记录的成交数量、实际清算金额和状态",
          "reason": "数量增加且资金流出说明买入，数量减少且资金流入说明卖出；状态正常后才进入后续处理。"
        },
        {
          "order": 2,
          "action": "完成 7 月 11 日买入凭证：成本 100,000 元、交易费用 120 元、席位佣金 80 元形成应付；按 -(100,000 + 120 - 80) = -100,040 元复算证券清算款",
          "reason": "成交金额形成股票成本，交易费用单独处理；佣金交易日确认，不因季度末支付而推迟确认；实际清算金额必须能由三项金额复算。"
        },
        {
          "order": 3,
          "action": "把买入后的 30,000 股、280,000 元成本和 35,000 元估值增值带入下一日持仓台账",
          "reason": "后续卖出成本必须以卖出前同一证券的账簿余额和结存数量为基础。"
        },
        {
          "order": 4,
          "action": "按 280,000 ÷ 30,000 = 9.333333... 元/股，复算卖出结转成本 9.333333... × 12,000 = 112,000 元、估值增值结转 35,000 × 12,000 ÷ 30,000 = 14,000 元，剩余 18,000 股、成本 168,000 元",
          "reason": "单位成本和估值增值都以卖出前余额与数量为基础，不能把卖出成交金额 132,000 元直接当作结转成本。"
        },
        {
          "order": 5,
          "action": "用 1,000,000 - 100,040 + 131,900 = 1,031,860 元复算期末资金，用 18,000 × 11.00 = 198,000 元复算收盘市值，再以 198,000 - 168,000 = 30,000 元复核估值增值",
          "reason": "期初资金、两笔实际清算、估值日收盘价、剩余数量和剩余成本共同证明连续业务链闭合，结果不能凭空出现。"
        }
      ],
      "summary": "读字段与状态 → 分开处理成本、费用和佣金 → 带入持仓台账 → 移动加权结转 → 资金与估值勾稽"
    },
