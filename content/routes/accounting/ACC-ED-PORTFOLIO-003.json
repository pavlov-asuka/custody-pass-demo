{
  "routeId": "ACC-ED-PORTFOLIO-003",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "投资组合、投资收益与披露附注勾稽",
  "summary": "从交易明细、凭证、估值表和披露附注读取股票、基金、债券投资字段，独立复算投资收益和公允价值，再按分子/分母重算组合比例并与利润表、资产负债表勾稽。",
  "estimatedMinutes": 65,
  "objectives": [
    "把交易明细、凭证和估值表的原始字段对应到股票、基金、债券投资收益和公允价值结果",
    "至少独立复算一条投资收益，并分别处理成交成本、费用、增值税、应计利息和公允价值变动",
    "用披露附注的分子/分母重新计算组合比例和合计，避免加总已舍入比例后再与主表勾稽"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ED-PORTFOLIO-KC-01",
          "type": "FLOW",
          "title": "先从原始交易字段建立收益链",
          "conclusion": "交易明细、凭证和估值表是投资收益的原始证据；收益计算必须保留成交金额、成本、费用和税费的方向。",
          "items": [
            "股票先按数量×单价复算成交金额",
            "基金赎回区分赎回款、成本、增值税和费用",
            "债券出售区分成本、应计利息和费用",
            "不要用披露附注的已舍入收益替代原始字段"
          ]
        },
        {
          "cardId": "ED-PORTFOLIO-KC-02",
          "type": "CATEGORIES",
          "title": "收益与公允价值是两条不同链",
          "conclusion": "已实现投资收益由交易字段复算，期末投资组合公允价值由成本、应计项目和公允价值变动复算，两项结果都要回到利润表。",
          "items": [
            "股票交易收益 = 交易价款 - 成本 - 费用",
            "基金收益 = 赎回款 - 成本 - 增值税 - 费用",
            "债券收益 = 出售价款 - 成本 - 应计利息 - 费用",
            "公允价值 = 成本 + 应计项目 + 公允价值变动"
          ]
        },
        {
          "cardId": "ED-PORTFOLIO-KC-03",
          "type": "KEY_POINT",
          "title": "比例必须按分子/分母重算",
          "conclusion": "披露附注比例按期末组合分项作为分子、批准的总资产作为分母逐项计算；不把已舍入的股票/基金/债券比例相加当作组合合计。",
          "items": [
            "先确认总资产分母和组合分子来自同一截止日",
            "比例保留未舍入中间值，最后统一精度",
            "合计比例用组合总额 ÷ 总资产重新计算",
            "比例、投资收益、公允价值和主表金额要互相勾稽"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "景行基金的投资组合复核人员",
        "product": "景行基金（示范合成产品）",
        "date": "2026-06-30",
        "purpose": "使用不同于综合实务的正常交易和估值数字，演示股票、基金、债券收益及组合比例的连续复核。",
        "facts": [
          "股票成交价款 4,500,000.00、成本 3,600,000.00、费用 50,000.00；基金赎回款 1,100,000.00、成本 700,000.00、增值税 30,000.00、费用 20,000.00。",
          "债券出售价款 2,200,000.00、成本 1,700,000.00、应计利息 200,000.00、费用 50,000.00。",
          "示范投资收益分别为 850,000.00、350,000.00、250,000.00，合计 1,450,000.00；估值组合为股票 10,000,000、基金 6,000,000、债券 8,500,000，合计 24,500,000。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "确认交易明细、凭证、估值表和附注属于景行基金 2026-06-30，股票/基金/债券单位和金额一致",
          "reason": "不同期间或不同来源对象不能直接拼接收益和比例。"
        },
        {
          "order": 2,
          "action": "复算股票收益 4,500,000 - 3,600,000 - 50,000 = 850,000，并复算基金 1,100,000 - 700,000 - 30,000 - 20,000 = 350,000",
          "reason": "费用和税费不能被隐藏在披露合计中。"
        },
        {
          "order": 3,
          "action": "复算债券收益 2,200,000 - 1,700,000 - 200,000 - 50,000 = 250,000，三类投资收益合计 1,450,000",
          "reason": "债券应计利息是收益链中的独立扣减字段。"
        },
        {
          "order": 4,
          "action": "用股票 10,000,000、基金 6,000,000、债券 8,500,000 分别除以批准总资产分母，并用组合合计 24,500,000 重新计算合计比例",
          "reason": "不能相加已舍入的分项比例代替分子/分母重算。"
        },
        {
          "order": 5,
          "action": "把投资收益和组合估值结果与主表/附注字段勾稽，记录正常 BALANCED 结论",
          "reason": "原始交易、估值、附注和主表四处的金额应能逐项对应。"
        }
      ],
      "summary": "锁定原始资料 → 股票/基金/债券收益复算 → 估值复算 → 按分子/分母重算比例 → 附注与主表核对"
    },
