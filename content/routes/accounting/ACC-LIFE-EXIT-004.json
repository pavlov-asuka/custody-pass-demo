  "line": "ACCOUNTING",
  "title": "合同终止、清盘与退出",
  "summary": "按合同终止、最后运作日和清算期间资料，计算剩余财产、单位净值、一次清算款与管理人垫款；完成回收和清偿后核对三表全零，再停止核算并退出。",
  "estimatedMinutes": 45,
  "objectives": [
    "从合同终止资料、清算方案、最后运作日余额表和垫款确认读取清盘字段，区分最后运作日、合同终止日、清算期间与停止核算日",
    "计算剩余财产、单位净值、一次清算款和管理人垫款，登记垫款到账与清算款支付凭证，复算支付后现金、保留资产与负债",
    "登记后续资产回收与负债清偿，核对余额表、资金调节表和估值表全零，再作出停止核算与退出结论"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ACC-EXIT-KC-01",
          "type": "FLOW",
          "title": "合同终止后仍要做账",
          "conclusion": "合同终止只表示产品进入清算阶段；最后运作日后清算期间仍要继续核算，只有余额、调节表和估值表全零并完成退出动作后才能停止核算。",
          "items": [
            "最后运作日：终止运作前的最后核算日",
            "合同终止日：进入清算阶段，核算不停止",
            "清算期间：继续处理未变现/未收回资产与未支付费用",
            "停止核算日：三表全零、账户销户并维护核算截止日之后"
          ]
        },
        {
          "cardId": "ACC-EXIT-KC-02",
          "type": "CATEGORIES",
          "title": "一次清算的金额关系",
          "conclusion": "先用资产和负债算剩余财产，再由份额算单位净值和一次清算款；可用现金不足的差额由管理人垫付。",
          "items": [
            "剩余财产 = 资产合计 - 负债合计",
            "单位净值 = 基金资产净值 ÷ 份额",
            "一次清算款 = 单位净值 × 份额",
            "管理人垫款 = 一次清算款 - 可用现金"
          ]
        },
        {
          "cardId": "ACC-EXIT-KC-03",
          "type": "KEY_POINT",
          "title": "最终退出证据",
          "conclusion": "后续资产回收、费用清偿和垫款返还要全部结清，余额表、资金调节表和估值表全零后才能确认停止核算与退出。",
          "items": [
            "后续回收：结算备付金解冻、应收利息到账",
            "负债清偿：支付应付费用、返还管理人垫款",
            "三表全零：余额表、资金调节表、估值表均为零",
            "退出动作：完成封账、账户销户并停止参与核算"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "明溪组合核算人员",
