          "explanation": "产品键、基金份额键和组合证券篮子键分别来自对应资料，二级成交编号不能代替其中任何一个对象。",
          "hints": [
            "先看资料标题和字段标签，再看值。",
            "二级成交量不是产品键，也不是篮子键。"
          ]
        },
        {
          "questionId": "ACC-ETF-OBJECT-Q-02",
          "type": "CALCULATION",
          "prompt": "本次正常一级业务有 2 个篮子，每篮形成 100000 份基金份额。计算本次形成的基金发行份额。",
          "calculation": {
            "fields": [
              {
                "fieldId": "createdShares",
                "label": "本次形成份额",
                "formula": "2 × 100000",
                "placeholder": "请输入本次形成份额",
                "unit": "份",
                "precision": 0,
                "tolerance": 0
              }
            ]
          },
          "answer": [
            "200000"
          ],
          "explanation": "2 × 100000 = 200000 份。",
          "hints": [
            "篮子数量与每篮份额相乘。",
            "结果按 2 位小数记录。"
          ]
        },
        {
          "questionId": "ACC-ETF-OBJECT-Q-03",
          "type": "LEDGER_ENTRY",
          "prompt": "补全这笔业务的份额记录：一级形成 200000 份，二级已结算成交 80000 份，一级结算后发行份额为 5200000 份。",
          "ledgerEntries": [
            {
              "entryId": "primary-created",
              "direction": "INCREASE",
              "label": "一级形成基金发行份额",
              "amount": "200000",
              "placeholder": "请输入一级形成份额"
            },
            {
              "entryId": "secondary-transfer",
              "direction": "TRANSFER",
              "label": "二级持有人间转让",
              "amount": "80000",
              "placeholder": "请输入二级成交数量"
            },
            {
              "entryId": "post-primary-issued",
              "direction": "BALANCE",
              "label": "一级结算后基金发行份额",
              "amount": "5200000",
              "placeholder": "请输入一级结算后发行份额"
            }
          ],
          "answer": [
            "200000",
            "80000",
            "5200000"
          ],
          "explanation": "一级形成份额进入发行份额记录，二级成交只记录转让，一级结算后发行份额为 5200000 份。",
          "hints": [
            "把一级形成和二级转让分成两类记录。",
            "余额使用发行前份额加一级形成份额。"
          ]
        },
        {
          "questionId": "ACC-ETF-OBJECT-Q-04",
          "type": "RECONCILIATION",
          "prompt": "核对一级结算后发行份额、二级成交数量和二级结算后发行份额，确认二级交易是否改变基金发行份额。",
          "reconciliation": {
            "fields": [
              {
                "fieldId": "postPrimaryIssued",
                "label": "一级结算后发行份额",
                "kind": "NUMBER",
                "formula": "5000000 + 200000",
                "placeholder": "请输入一级结算后发行份额",
                "precision": 0,
                "tolerance": 0
              },
              {
                "fieldId": "secondaryIssuedDelta",
                "label": "二级后发行份额差额",
                "kind": "NUMBER",
                "formula": "二级后发行份额 - 一级结算后发行份额",
                "placeholder": "请输入发行份额差额",
                "precision": 0,
                "tolerance": 0
              },
              {
                "fieldId": "conclusion",
                "label": "业务结论",
                "kind": "SELECT",
                "formula": "差额为零时确认二级交易未改变发行份额",
                "placeholder": "请选择业务结论",
                "options": [
                  {
                    "optionId": "ETF01_A_SECONDARY_SETTLED",
                    "text": "二级已结算且发行份额未改变"
                  },
                  {
                    "optionId": "ETF01_A_ISSUED_CHANGED",
                    "text": "二级交易改变了基金发行份额"
                  }
                ]
              }
            ]
          },
          "answer": [
            "5200000",
            "0",
            "ETF01_A_SECONDARY_SETTLED"
          ],
          "explanation": "5200000 - 5200000 = 0；二级成交已结算但发行份额未改变。",
          "hints": [
            "先复算一级结算后发行份额。",
            "差额要比较发行份额，不比较持有人转让数量。"
          ]
        },
        {
          "questionId": "ACC-ETF-OBJECT-Q-05",
          "type": "SHORT_TEXT",
          "prompt": "用一句话写出这笔业务的对象边界和最终发行份额结论。",
          "textInput": {
            "label": "对象与发行份额结论",
            "placeholder": "请写出产品、一级形成份额、二级后发行份额和差额"
          },
          "answer": [
            "产品 ETF-EDU-A-01；一级形成 200000 份；二级后发行份额 5200000 份；发行份额差额 0 份。"
          ],
          "explanation": "结论同时保留产品身份、一级形成结果、二级后发行份额和差额。",
          "hints": [
            "不要把二级成交 80000 份加到发行份额。",
            "结论至少包含四个结构化结果。"
          ]
        }
      ]
    },
