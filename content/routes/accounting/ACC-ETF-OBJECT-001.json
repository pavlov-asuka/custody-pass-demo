{
  "routeId": "ACC-ETF-OBJECT-001",
  "contentVersion": "2026.08.14.1",
  "line": "ACCOUNTING",
  "title": "区分 ETF 产品、份额与一级二级边界",
  "summary": "从产品登记、基金份额和组合证券三个对象出发，核对一级申赎形成的发行份额与二级交易后的发行份额。",
  "estimatedMinutes": 28,
  "objectives": [
    "能从原始登记和申赎资料分别定位 ETF 产品、基金份额和组合证券/篮子。",
    "能用篮子数量和每篮份额计算一级申赎形成的基金发行份额。",
    "能把二级交易记为持有人间转让，并证明交易后基金发行份额不变。"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ACC-ETF-OBJECT-001-KC-01",
          "type": "CATEGORIES",
          "title": "三个对象先分开",
          "conclusion": "产品、基金份额、组合证券是不同登记对象，不能用一个代码或一张结果表替代。",
          "items": [
            "产品对象回答是哪只 ETF 产品。",
            "基金份额对象回答基金发行份额是多少。",
            "组合证券/篮子对象回答一次申赎交付哪些证券及数量。"
          ]
        },
        {
          "cardId": "ACC-ETF-OBJECT-001-KC-02",
          "type": "FLOW",
          "title": "一级申赎形成发行份额",
          "conclusion": "一级业务以篮子数量乘每篮份额承接基金发行份额的增减。",
          "items": [
            "先读申赎清单中的篮子数量和每篮份额。",
            "再将本次形成的份额登记到基金发行份额。",
            "最后用发行前后份额核对一级结果。"
          ]
        },
        {
          "cardId": "ACC-ETF-OBJECT-001-KC-03",
          "type": "KEY_POINT",
          "title": "二级交易只改变持有人转让",
          "conclusion": "二级交易不改变基金发行份额；交易完成后，基金发行份额保持一级结果，不把成交量再次加到基金发行份额。",
          "items": [
            "读取二级成交数量作为转让记录。",
            "将交易后的发行份额与一级结算后的发行份额比较。",
            "差额为零后，才能确认对象边界没有被二级交易改变。"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "caseId": "ETF01-A-EDU-01",
        "role": "ETF 运营核算岗",
        "product": "ETF-EDU-A-01",
        "date": "案例版本快照-2026-08-14",
        "purpose": "完成一次正常一级形成与二级结算后的对象和发行份额确认"
      },
      "steps": [
        {
          "order": 1,
          "action": "从产品登记资料读取产品键 ETF-EDU-A-01、基金份额对象 ETF-SHARE-EDU-A-01 和组合证券篮子 BASKET-ETF01-A-001。",
          "reason": "先固定三个对象的来源，避免把篮子证券或成交数量当成基金份额。"
        },
        {
          "order": 2,
          "action": "从申赎资料读取本次 2 个篮子、每篮 100000 份，计算一级形成份额 200000 份。",
          "reason": "资料中的篮数和份额均按整数记录，一级形成份额精度 0、容差 0。"
        },
        {
          "order": 3,
          "action": "将 200000 份登记到发行份额：5000000 + 200000 = 5200000 份。",
          "reason": "一级确认是基金发行份额的变动来源。"
        },
        {
          "order": 4,
          "action": "读取二级成交 80000 份作为持有人间转让，并记录交易已结算。",
          "reason": "二级成交数量需要留痕，但不重复进入基金发行份额。"
        },
        {
          "order": 5,
          "action": "核对二级结算后发行份额 5200000 份与一级结算后发行份额，差额 0 份。",
          "reason": "发行份额不因二级交易改变，零差额是对象边界的业务结论。"
        }
      ],
      "summary": "资料中的数字关系为：2 × 100000 = 200000；5000000 + 200000 = 5200000；二级交易 80000 不改变发行份额，核对差额为 0。"
    },
