{
  "routeId": "ACC-CBF-DATA-002",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "数据接收、解析、完整性与可启动状态",
  "summary": "从两套完整正常资料读取同日键、文件组版本、记录数、数量/金额控制总额、解析行数、映射行数和完整性字段，按证据确认RECEIVED、PARSED、MAPPED、COMPLETE、READY，并核对日间/日终双源结果。",
  "estimatedMinutes": 70,
  "objectives": [
    "从接收登记、日间资料组、日终资料组和映射/完整性工作纸定位业务日期、市场键、组合键、证券键、文件组版本和记录控制字段",
    "依据记录数与解析行数、解析行数与映射行数、必需字段和同日键字段，逐项确认RECEIVED、PARSED、MAPPED、COMPLETE，而不是背诵状态顺序",
    "用独立Decimal复算记录数、数量控制总额、金额控制总额以及解析/映射行数差，不把它们带入佣金、交收或备付金主金额链",
    "核对日间与日终资料的记录、数量和金额控制总额；同日键、字段映射和完整性全部通过后才判定READY"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "CBF-R2-KC-01",
          "type": "FLOW",
          "title": "状态要由资料字段证明",
          "conclusion": "收到、解析、映射、完整和可启动对应不同证据；每一步都要回到资料字段和控制结果。",
          "items": [
            "RECEIVED看接收登记、文件组ID、文件组版本、业务日期、同日键和记录数是否可读",
            "PARSED看记录数与parsedRows相等且parseStatus为PASS",
            "MAPPED看parsedRows与mappedRows相等且mappingStatus为PASS",
            "COMPLETE看必需字段、同日键、数量控制总额和金额控制总额均可验证"
          ]
        },
        {
          "cardId": "CBF-R2-KC-02",
          "type": "CATEGORIES",
          "title": "控制总额只回答资料完整性",
          "conclusion": "记录数、数量和金额控制总额及其差额用于确认资料能否进入后续核算；不把控制总额计算扩展成佣金、交收或备付金核算。",
          "items": [
            "记录数 = 明细行数；解析行数差 = parsedRows − recordCount",
            "数量控制总额 = 各明细quantity的Decimal合计",
            "金额控制总额 = 各明细amount的Decimal合计",
            "日间/日终双源差额分别比较记录数、数量控制总额和金额控制总额"
          ]
        },
        {
          "cardId": "CBF-R2-KC-03",
          "type": "KEY_POINT",
          "title": "收到和解析不等于可启动",
          "conclusion": "READY必须同时满足同日键一致、字段映射完成、记录/数量/金额完整性通过和双源差额为零；这组正常资料的结论为READY。",
          "items": [
            "接收成功只证明资料已登记，不证明结构已解析",
            "解析成功只证明字段可读，不证明字段已经映射和完整",
            "映射成功和字段完整还要经过日间/日终控制总额核对",
            "全部条件通过后，才能在数据接收与可启动状态工作纸记录READY"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "数据接收与核算工作角色",
        "product": "券结基金单券商单市场普通证券资料批次",
        "date": "2026-08-13",
        "fixture": "CBF-R2-FIXTURE-DEMO-A",
        "facts": [
          "接收登记、日间资料组和日终资料组共同给出业务日期2026-08-13、市场键MARKET_DATA_A、组合键PORTFOLIO_DATA_A和证券键SECURITY_DATA_A。",
          "日间文件组CASE_DAY_DATA_A和日终文件组CASE_EOD_DATA_A的版本均为CASE-FORMAT-A-01；两组各3条记录、数量控制总额15000、金额控制总额625000.00。",
          "两组parsedRows均为3、mappedRows均为3、parseStatus/mappingStatus/requiredFieldCheck/sameDayKeyCheck均为PASS。",
          "所有标识、版本、行数和金额均为合成教学参数，不代表生产文件格式或永久规则。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "从接收登记读取业务日期、市场键、组合键、证券键、两个文件组ID、版本和记录数，确认资料批次可识别并记录RECEIVED",
          "reason": "RECEIVED需要可定位的接收证据；只看到一个系统状态词不能替代文件组和同日键字段。"
        },
        {
          "order": 2,
          "action": "分别比较日间和日终资料的recordCount=3与parsedRows=3，并读取parseStatus=PASS，记录PARSED",
          "reason": "解析状态要由记录数与解析行数相等来确认，不能由接收成功推断。"
        },
        {
          "order": 3,
          "action": "分别比较parsedRows=3与mappedRows=3，并读取mappingStatus=PASS，将资料字段关联字段字典，记录MAPPED",
          "reason": "映射完成必须有行数关系和映射结果字段，不能把解析行数直接当成映射行数。"
        },
        {
          "order": 4,
          "action": "把三条明细分别相加：数量5000+4000+6000=15000，金额210000.00+165000.00+250000.00=625000.00；检查必需字段和四个同日键均为PASS，记录COMPLETE",
          "reason": "COMPLETE要同时有字段存在、键一致和可复算控制总额；本步骤不计算佣金或备付金。"
        },
        {
          "order": 5,
          "action": "核对日间/日终记录差0、数量差0、金额差0.00，确认映射和完整性均通过，在数据接收与可启动状态工作纸记录READY",
          "reason": "收到或解析并不等于可启动；只有同日键、映射、记录/数量/金额完整性及双源差额全部通过才可READY。"
        }
      ],
      "summary": "接收字段 → 解析行数 → 映射行数 → 完整性控制总额 → 双源零差异 → READY"
    },
    "BASIC_PRACTICE": {
      "questions": [
        {
          "questionId": "ACC-CBF-DATA-Q-01",
          "type": "FIELD_MAP",
          "prompt": "把Demo A五个状态的证据字段映射到资料或工作纸来源。",
          "fieldMappings": [
            {
              "fieldId": "received-proof",
              "label": "RECEIVED证明",
              "source": "接收登记/CASE_DAY_DATA_A与CASE_EOD_DATA_A",
              "options": [
                {"optionId": "INTAKE_KEYS_VERSION_COUNT", "text": "同日键、文件组版本和记录数可读"},
                {"optionId": "READY_ONLY", "text": "只看最终READY字段"}
              ]
            },
            {
              "fieldId": "parsed-proof",
              "label": "PARSED证明",
              "source": "日间/日终资料组解析结果",
              "options": [
                {"optionId": "PARSED_ROWS_EQUAL_RECORDS", "text": "parsedRows=recordCount且parseStatus=PASS"},
                {"optionId": "MAPPED_ROWS_ONLY", "text": "只看mappedRows"}
              ]
            },
            {
              "fieldId": "mapped-proof",
              "label": "MAPPED证明",
              "source": "字段映射工作纸",
              "options": [
                {"optionId": "MAPPED_ROWS_EQUAL_PARSED", "text": "mappedRows=parsedRows且mappingStatus=PASS"},
                {"optionId": "RECEIVED_STATUS_ONLY", "text": "只看receivedStatus"}
              ]
            },
            {
              "fieldId": "complete-proof",
              "label": "COMPLETE证明",
              "source": "必需字段与同日键检查",
              "options": [
                {"optionId": "REQUIRED_FIELDS_KEYS_CONTROLS", "text": "必需字段、四个同日键及数量/金额控制总额均可验证"},
                {"optionId": "PARSE_PASS_ONLY", "text": "只要parseStatus=PASS即可"}
              ]
            },
            {
              "fieldId": "ready-proof",
              "label": "READY证明",
              "source": "日间/日终双源勾稽工作纸",
              "options": [
                {"optionId": "TWO_SOURCE_ZERO_AND_COMPLETE", "text": "双源记录/数量/金额差均为零且完整性闭合"},
                {"optionId": "RECEIVED_OR_PARSED", "text": "收到或解析成功即可"}
              ]
            }
          ],
          "answer": ["INTAKE_KEYS_VERSION_COUNT", "PARSED_ROWS_EQUAL_RECORDS", "MAPPED_ROWS_EQUAL_PARSED", "REQUIRED_FIELDS_KEYS_CONTROLS", "TWO_SOURCE_ZERO_AND_COMPLETE"],
          "explanation": "五个状态分别需要接收字段、解析行数、映射行数、完整性/同日键和双源零差异证据；前一状态不能替代后一状态。",
          "hints": ["按RECEIVED→PARSED→MAPPED→COMPLETE→READY逐项找字段证据。"]
        },
        {
          "questionId": "ACC-CBF-DATA-Q-02",
          "type": "CALCULATION",
          "prompt": "按Demo A明细计算记录数、数量/金额控制总额，以及解析和映射行数差。",
          "calculation": {
            "fields": [
              {"fieldId": "record-count", "label": "明细记录数", "formula": "3条明细", "placeholder": "输入行数", "unit": "行", "precision": 0, "tolerance": 0},
              {"fieldId": "quantity-total", "label": "数量控制总额", "formula": "5000+4000+6000", "placeholder": "输入数量", "unit": "份", "precision": 0, "tolerance": 0},
              {"fieldId": "amount-total", "label": "金额控制总额", "formula": "210000.00+165000.00+250000.00", "placeholder": "输入金额", "unit": "元", "precision": 2, "tolerance": 0.01},
              {"fieldId": "parsed-row-diff", "label": "解析行数差", "formula": "parsedRows−recordCount", "placeholder": "输入行数差", "unit": "行", "precision": 0, "tolerance": 0},
              {"fieldId": "mapped-row-diff", "label": "映射行数差", "formula": "mappedRows−parsedRows", "placeholder": "输入行数差", "unit": "行", "precision": 0, "tolerance": 0}
            ]
          },
          "answer": ["3", "15000", "625000.00", "0", "0"],
          "explanation": "Demo A三条明细的记录数为3、数量合计15000、金额合计625000.00，解析和映射行数差均为0。",
          "hints": ["只计算行数、数量和金额控制关系，不引入佣金、交收或备付金字段。"]
        },
        {
          "questionId": "ACC-CBF-DATA-Q-03",
          "type": "LEDGER_ENTRY",
          "prompt": "用数据接收与可启动状态工作纸记录Demo A五个状态，不补造系统字段。",
          "ledgerEntries": [
            {"entryId": "received-state", "direction": "状态", "label": "资料已收到", "amount": "RECEIVED", "placeholder": "输入状态"},
            {"entryId": "parsed-state", "direction": "状态", "label": "结构已解析", "amount": "PARSED", "placeholder": "输入状态"},
            {"entryId": "mapped-state", "direction": "状态", "label": "字段已映射", "amount": "MAPPED", "placeholder": "输入状态"},
            {"entryId": "complete-state", "direction": "状态", "label": "业务数据完整", "amount": "COMPLETE", "placeholder": "输入状态"},
            {"entryId": "ready-state", "direction": "状态", "label": "可启动核算", "amount": "READY", "placeholder": "输入状态"}
          ],
          "answer": ["RECEIVED", "PARSED", "MAPPED", "COMPLETE", "READY"],
          "explanation": "工作纸记录能从字段和控制结果确认的状态，不添加系统菜单、按钮或未解释字段。",
          "hints": ["逐项找到接收、解析、映射和完整性字段；READY必须放在完整性和双源核对之后。"]
        },
        {
          "questionId": "ACC-CBF-DATA-Q-04",
          "type": "RECONCILIATION",
          "prompt": "核对Demo A日间与日终资料的记录、数量和金额控制总额，并判断能否READY。",
          "reconciliation": {
            "fields": [
              {"fieldId": "record-diff", "label": "记录数差", "kind": "NUMBER", "formula": "3−3", "placeholder": "输入行数差", "precision": 0, "tolerance": 0},
              {"fieldId": "quantity-diff", "label": "数量控制总额差", "kind": "NUMBER", "formula": "15000−15000", "placeholder": "输入数量差", "precision": 0, "tolerance": 0},
              {"fieldId": "amount-diff", "label": "金额控制总额差", "kind": "NUMBER", "formula": "625000.00−625000.00", "placeholder": "输入金额差", "precision": 2, "tolerance": 0.01},
              {"fieldId": "ready-result", "label": "可启动结论", "kind": "SELECT", "formula": "差额为零且COMPLETE已证明", "placeholder": "选择结论", "options": [{"optionId": "READY", "text": "双源控制闭合，可以READY"}, {"optionId": "NOT_READY", "text": "仍需补充资料"}]}
            ]
          },
          "answer": ["0", "0", "0.00", "READY"],
          "explanation": "日间与日终资料记录数、数量和金额控制总额均一致，且完整性已通过，因此这组资料可READY。",
          "hints": ["先分别算三项差额，再确认COMPLETE证据已存在，不能只看received或parsed。"]
        },
        {
          "questionId": "ACC-CBF-DATA-Q-05",
          "type": "SHORT_TEXT",
          "prompt": "用一句话说明为什么Demo A收到并解析后，还必须经过映射、完整性和双源核对才能READY。",
          "textInput": {"label": "数据可启动结论", "placeholder": "写明五状态、同日键、字段映射、控制总额和READY边界"},
          "answer": ["RECEIVED", "PARSED", "MAPPED", "COMPLETE", "READY", "同日键", "字段映射", "记录", "数量", "金额", "零差"],
          "explanation": "结论要指出状态由字段和控制结果逐步确认，收到/解析不等于可启动。",
          "hints": ["按状态证据顺序组织句子，并明确READY需要同日键、映射和三项控制总额均无差额。"]
        }
      ]
    },
