{
  "routeId": "ACC-CBF-BOUNDARY-001",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "对象、业务角色与责任映射",
  "summary": "从同一券商、单市场、单日普通证券买入资料中，分别定位交易、备付金、持仓和估值结果；区分资料提供与核算复核责任，填入角色工作纸，再用 Decimal 复算并核对零差异。",
  "estimatedMinutes": 70,
  "objectives": [
    "从日内交易、日终券商对账、估值结果和复核资料组定位字段来源，并核对业务日期、市场、组合和证券键",
    "把交易对象、清算交收、券商备付金、证券持仓和估值结果分成业务角色；不以真实账户或未闭合的正式会计科目代替",
    "用独立 Decimal 链复算成交总额、佣金、交收金额、备付金余额、持仓数量和估值市值，把结果填入业务角色工作纸",
    "当资金、持仓、估值数量和备付金差额均为零且复核已确认时，判断映射是否可以进入后续处理"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "CBF-R1-KC-01",
          "type": "CATEGORIES",
          "title": "先分对象，再认资料来源",
          "conclusion": "先把资料按交易对象、日终对账对象、估值结果对象和复核对象分开；来源正确还要支持金额计算和零差异核对。",
          "items": [
            "日内交易资料组提供买卖方向、数量、价格和成交金额所需字段",
            "日终券商对账资料组提供备付金和持仓期初/期末字段",
            "估值结果资料组独立承载估值价格、估值数量和估值市值",
            "所有来源先用业务日期、市场键、组合键和证券键做同日关联"
          ]
        },
        {
          "cardId": "CBF-R1-KC-02",
          "type": "FLOW",
          "title": "责任角色和业务角色要分层",
          "conclusion": "资料提供、核算、估值复核和托管复核可以分工；券商备付金、证券持仓和估值结果是不同业务角色。",
          "items": [
            "BROKER_DATA_PROVIDER负责交易资料组和对账资料组的提供",
            "ACCOUNTING_WORKER负责读字段、建映射、算金额和补业务角色工作纸",
            "VALUATION_REVIEWER负责确认估值价格、数量和结果资料的对应关系",
            "CUSTODY_REVIEWER负责确认同日资料、零差异和复核状态满足收口条件"
          ]
        },
        {
          "cardId": "CBF-R1-KC-03",
          "type": "KEY_POINT",
          "title": "角色映射必须可计算、可勾稽",
          "conclusion": "映射成立的证据不是名称，而是来源字段能进入计算、工作纸和零差异核对。",
          "items": [
            "成交总额 = 成交数量 × 成交价格",
            "佣金金额 = 成交总额 × 佣金率；交收金额 = 成交总额 + 佣金金额",
            "买入后备付金期末余额和持仓期末数量必须能由期初与交易结果复算",
            "估值数量、备付金和复核状态要能和日终结果互相核对"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "核算工作角色",
        "product": "券结基金单日普通证券交易",
        "date": "2026-08-12",
        "fixture": "CBF-FIXTURE-DEMO-A",
        "facts": [
          "同一业务日期、市场键MARKET_CASE_01、组合键PORTFOLIO_CASE_01和证券键SECURITY_CASE_01在四组资料中一致。",
          "日内交易资料组给出BUY、8000份、42.50元、佣金率0.0012；日终券商对账资料组给出备付金期初800000.00元、期末459592.00元和持仓期初2000份、期末10000份。",
          "估值结果资料组给出估值价格42.80元、估值数量10000份、估值市值428000.00元和估值备付金459592.00元；复核确认资料组为YES。",
          "标识和数值为合成教学参数。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "先按四个同日键把日内交易资料组、日终券商对账资料组、估值结果资料组和复核确认资料组归入同一业务对象",
          "reason": "跨来源映射的第一道证据是业务日期、市场、组合和证券键一致，而不是资料标题相似。"
        },
        {
          "order": 2,
          "action": "把日内交易资料组映射到TRADE_OBJECT/CLEARING_SETTLEMENT_ROLE，把日终券商对账资料组分别映射到BROKER_RESERVE_ROLE和SECURITIES_LEDGER_ROLE，把估值结果资料组映射到VALUATION_RESULT_ROLE",
          "reason": "交易、资金、持仓和估值结果承担不同业务含义，不能用一个来源或一个账户角色覆盖全部对象。"
        },
        {
          "order": 3,
          "action": "将资料提供责任映射给BROKER_DATA_PROVIDER，将读字段、计算和工作纸动作映射给ACCOUNTING_WORKER，将结果确认映射给VALUATION_REVIEWER/CUSTODY_REVIEWER",
          "reason": "责任映射要能说明谁提供、谁处理和谁复核，避免把资料来源当成金额已入账。"
        },
        {
          "order": 4,
          "action": "独立计算8000×42.50=340000.00，340000.00×0.0012=408.00，交收金额=340408.00；800000.00−340408.00=459592.00，2000+8000=10000，10000×42.80=428000.00",
          "reason": "只有计算结果能够回到备付金、持仓和估值资料，字段映射才具有可验证的业务含义。"
        },
        {
          "order": 5,
          "action": "在业务角色工作纸记录备付金减少340408.00、持仓期末10000份和估值市值428000.00，并核对资金差0.00、持仓差0、估值数量差0、备付金差0.00及复核YES",
          "reason": "映射是否成立，要看来源、责任、角色、计算和零差异核对能否相互对应。"
        }
      ],
      "summary": "同日键 → 来源与对象 → 责任分层 → Decimal计算 → 角色工作纸与零差异验证"
    },
