{
  "routeId": "ACC-FI-PARTIAL-REDEMPTION-103",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "债券部分兑付：公告口径、余额结转与重新计息",
  "summary": "根据批准公告区分减面值与减数量，核对本金、成本、估值增值，并按剩余持仓重算后续计息基础。",
  "estimatedMinutes": 45,
  "objectives": [
    "从公告读取部分兑付方式",
    "按批准口径结转本金和账簿余额",
    "读取批准计息快照并在减少数量后重新计算",
    "用凭证、台账和独立公式完成结果勾稽"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "FI-PR-KC-01",
          "type": "CATEGORIES",
          "title": "公告先决定减少面值还是数量",
          "conclusion": "部分兑付的本金处理必须服从同一份有效公告；市场惯例不能替代公告字段。",
          "items": [
            "减少面值不当然减少债券数量",
            "公告明确减少数量时才减少持仓数量",
            "到期兑付款项自兑付日起不再计提利息",
            "这里只处理正常公告和批准快照"
          ]
        },
        {
          "cardId": "FI-PR-KC-02",
          "type": "FLOW",
          "title": "余额结转跟着兑付方式走",
          "conclusion": "减少数量参照卖出处理按比例结转成本和估值增值；减少面值按批准模式处理。",
          "items": [
            "实付本金=实付数量×每张面值或公告给定偿还面值",
            "成本与估值增值的结转对象必须与方式一致",
            "投资收益按批准模式确认",
            "不把兑付本金直接当作剩余持仓成本"
          ]
        },
        {
          "cardId": "FI-PR-KC-03",
          "type": "KEY_POINT",
          "title": "数量变化后必须重新计息",
          "conclusion": "减少数量会改变后续计息基础；按批准计息快照读取 FI-002 的计息来源和算法，计算并核对新结果，不把快照外推为永久规则。",
          "items": [
            "先读取批准资料的计息来源、年利息、日数口径和已过天数",
            "票面总额=兑付后张数×每张面值，不能用张数直接代替票面总额",
            "每百元应计利息=批准年利息×已过天数÷365，保留2位小数",
            "总应计利息=每百元应计利息×票面总额÷100，再与兑付后计息台账勾稽",
            "不能以兑付前累计应计利息或只填重新生成状态替代数值复算"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "产品甲的组合核算人员",
        "product": "产品甲 / 债券甲",
        "date": "2026-08-28",
        "facts": [
          "批准公告明确兑付后减少 2,000 张债券数量，不是只减少面值。",
          "兑付数量 2,000 张，每张面值 100 元，实付本金 200,000 元。",
          "兑付前数量 10,000 张，成本 960,000 元，估值增值 40,000 元。",
          "批准口径按减少数量参照卖出处理，兑付后剩余数量重新计息。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "读取公告，确认这笔兑付是减少数量而非减少面值",
          "reason": "公告字段决定持仓数量是否变化。"
        },
        {
          "order": 2,
          "action": "计算实付本金 2,000 张×100 元/张=200,000 元，并按 2,000/10,000 结转成本 192,000 元和估值增值 8,000 元",
          "reason": "减少数量参照卖出处理按比例结转。"
        },
        {
          "order": 3,
          "action": "补全兑付凭证：借银行存款/清算款 200,000 元，贷成本 192,000 元、估值增值 8,000 元，差额按批准口径入投资收益",
          "reason": "本金、成本和估值增值必须按同一兑付数量结转后逐项相等。"
        },
        {
          "order": 4,
          "action": "核对剩余数量 8,000 张、剩余成本 768,000 元和剩余估值增值 32,000 元",
          "reason": "数量和余额都应从兑付前台账连续结转。"
        },
        {
          "order": 5,
          "action": "读取批准计息快照：3.65% 年利息、实际天数/365、已过 91 天；兑付后票面总额=8,000 张×100 元/张=800,000 元；每百元应计利息=3.65×91÷365=0.91 元；总应计利息=0.91×800,000÷100=7,280.00 元，并与计息台账核对后标记已重新生成",
          "reason": "数量变化后必须用剩余票面总额重新计算；这组批准快照只读取 FI-002 的计息来源和算法，不外推为永久规则。"
        }
      ],
          "summary": "读公告→判定减数量→按比例结转→核对剩余台账→按批准快照重算利息→对上计息台账"
    },
