      "steps": [
        {
          "order": 1,
          "action": "从已确认交易结果定位业务日期、市场/组合/证券键、数量9000和成交价格28.40，并读取成交结果确认状态",
          "reason": "这里承接已确认交易结果，只读取交收所需字段，不把买卖方向或股票成本重新作为学习对象。"
