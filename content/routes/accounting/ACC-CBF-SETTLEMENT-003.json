        },
        {
          "order": 3,
          "action": "独立计算gross=9000×28.40=255600.00，commission=255600.00×0.0011=281.16，settlement=255600.00+281.16=255881.16",
          "reason": "四个结果中的前三个分别回答成交、佣金和券商交收，佣金必须按批准时点进入同日现金链。"
