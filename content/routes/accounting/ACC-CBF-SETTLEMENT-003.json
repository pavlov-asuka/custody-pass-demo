{
  "routeId": "ACC-CBF-SETTLEMENT-003",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "普通证券交易的券商交收、佣金时点与备付金",
  "summary": "承接已确认的普通证券交易结果，按批准参数复算成交总额、佣金、同日券商交收、备付金现金变动和期末余额，再用公式和外部资金对账核对两处差额。",
  "estimatedMinutes": 75,
  "objectives": [
    "从已确认交易结果、批准参数、券商资金对账和角色化结转工作纸定位成交总额、佣金率/时点、备付金余额和外部余额字段",
    "区分成交总额、佣金金额、交收金额和备付金变化四个业务结果，不用历史T+0记忆、历史费率或正式科目推断结果",
    "用独立Decimal链复算gross、commission、settlement、reserve movement和reserve close，并标明现金方向",
    "用公式恒等式、备付金余额公式、外部券商资金对账差额和一次角色化结转核对结果"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "CBF-R3-KC-01",
          "type": "CATEGORIES",
          "title": "四个金额结果不是同一个字段",
          "conclusion": "成交总额是数量与价格的结果，佣金是批准费率作用于成交总额的结果，交收金额是两者之和，备付金变化是交收导致的现金方向变化。",
          "items": [
            "gross = quantity × tradePrice，描述成交结果，不直接等于现金流出",
            "commission = gross × 批准commissionRate，时点由批准参数给出",
            "settlement = gross + commission，是同日券商交收金额",
            "reserveMovement = −settlement，reserveClose = reserveOpen − settlement"
          ]
        },
        {
          "cardId": "CBF-R3-KC-02",
          "type": "FLOW",
          "title": "先定位批准参数，再进入现金链",
          "conclusion": "佣金率和佣金进入现金链的时点都从批准参数读取；历史T+0表述、历史费率和正式科目不能代替资料。",
          "items": [
            "已确认交易结果只提供交收需要的数量、价格和成交总额",
            "批准参数提供commissionRate、commissionCashTiming、settlementTiming、精度和容差",
            "券商资金对账提供reserveOpen、外部cashMovement和reserveClose",
            "角色化工作纸记录一次交收结转及现金方向，不补造会计科目、借贷或系统字段"
          ]
        },
        {
          "cardId": "CBF-R3-KC-03",
          "type": "KEY_POINT",
          "title": "金额链和外部余额分别核对",
          "conclusion": "交收金额之外，还要核对公式恒等式、备付金余额关系和外部对账余额差，并确认结转只记录一次。",
          "items": [
            "formulaDiff = gross + commission − settlement = 0.00",
            "reserveFormulaDiff = reserveOpen − settlement − reserveClose = 0.00",
            "externalBalanceDiff = externalStatementClosing − reserveClose = 0.00",
            "postingCount − 1 = 0，说明没有重复结转"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "券结交收与资金工作角色",
        "product": "券结基金单券商单市场普通证券交易",
