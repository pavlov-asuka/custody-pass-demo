      "steps": [
        {
          "order": 1,
          "action": "读取期初余额表、结息单、支付指令、资金流水与费用计提依据，确认当日实际发生利息收入 15,000 元、计提 3,000 元、支付 10,000 元",
          "reason": "先确认金额来源、实际到账/支付与状态，再进入账务处理；支付指令不能替代资金流水证明已支付。"
        },
        {
          "order": 2,
          "action": "计算期末现金 2,000,000 + 15,000 - 10,000 = 2,005,000 元，期末应付费用 40,000 + 3,000 - 10,000 = 33,000 元，当日净结果 15,000 - 3,000 = 12,000 元",
          "reason": "现金与应付余额分别按实际到账/支付和计提口径复算，当日结果由收入减计提得到。"
        },
        {
          "order": 3,
          "action": "完成三张凭证并更新台账：借银行存款 15,000、贷利息收入 15,000；借费用 3,000、贷应付费用 3,000；借应付费用 10,000、贷银行存款 10,000",
          "reason": "收入、计提与支付分别形成凭证，现金账簿和费用台账随凭证同步更新。"
        },
        {
          "order": 4,
          "action": "完成晚间估值：期末净资产 2,005,000 + 18,000,000 - 33,000 = 19,972,000 元，单位净值 19,972,000 ÷ 20,000,000 = 0.9986 元",
          "reason": "估值结果是现金、投资资产与负债的连续关系，单位净值按题面精度复算。"
        },
        {
          "order": 5,
          "action": "用资金调节表、电子对账关键项和封账检查表核对，确认期末现金、应付费用、净资产与净值一致后正常封账",
          "reason": "第二来源验证闭合后，正常封账是当日核算的结论，不是异常处理。"
        }
      ],
      "summary": "读资料定发生 → 计算现金/应付/结果 → 凭证与台账 → 估值与净值 → 勾稽与正常封账"
    },
