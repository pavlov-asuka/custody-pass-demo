                {
                  "optionId": "INCOME_STATEMENT",
                  "text": "收入总额减费用总额"
                },
                {
                  "optionId": "BALANCE_SHEET",
                  "text": "资产总额减负债总额"
                }
              ]
            }
          ],
          "answer": [
            "CASH_LEDGER",
            "VALUATION_SHEET",
            "INCOME_STATEMENT"
          ],
          "explanation": "现金、估值资产和利润分别回到对应资料来源，主表之间只做勾稽，不互相伪造来源。",
          "hints": [
            "先问这个字段能否由来源分项复算。"
          ]
        },
        {
          "questionId": "ACC-ED-STATEMENTS-Q-02",
          "type": "CALCULATION",
          "prompt": "复算远岚基金示范的资产负债表和利润表。",
          "calculation": {
            "fields": [
              {
                "fieldId": "asset-total",
                "label": "资产总额",
                "formula": "2,400,000 + 31,000,000 + 600,000",
                "placeholder": "输入金额",
                "unit": "元",
                "precision": 2,
                "tolerance": 0.01
              },
              {
                "fieldId": "statement-net-assets",
                "label": "资产减负债的净资产",
                "formula": "34,000,000 - 400,000",
                "placeholder": "输入金额",
                "unit": "元",
                "precision": 2,
                "tolerance": 0.01
              },
              {
                "fieldId": "profit-total",
                "label": "本期利润",
                "formula": "2,200,000 - 400,000",
                "placeholder": "输入金额",
                "unit": "元",
                "precision": 2,
                "tolerance": 0.01
              }
            ]
          },
          "answer": [
            "34000000",
            "33600000",
            "1800000"
          ],
          "explanation": "资产总额、资产减负债的净资产和利润必须分别计算。",
          "hints": [
            "不要直接把示范中写出的净资产当作资产负债表计算结果。"
          ]
        },
        {
          "questionId": "ACC-ED-STATEMENTS-Q-03",
          "type": "LEDGER_ENTRY",
          "prompt": "把净资产变动表期末局部填入对应账簿/表格栏。",
          "ledgerEntries": [
            {
              "entryId": "contributed-fund",
              "direction": "期末余额",
              "label": "实收基金 31,800,000.00 元",
              "amount": "31,800,000.00 元",
              "placeholder": "输入表格栏"
            },
            {
              "entryId": "undistributed-profit",
              "direction": "期末余额",
              "label": "未分配利润 1,800,000.00 元",
              "amount": "1,800,000.00 元",
              "placeholder": "输入表格栏"
            }
          ],
          "answer": [
            "净资产变动表—实收基金",
            "净资产变动表—未分配利润"
          ],
          "explanation": "局部填表仍要让实收基金和未分配利润合计回到期末净资产。",
          "hints": [
            "填对象栏，不要把两项合成一个没有来源的净资产数。"
          ]
        },
        {
          "questionId": "ACC-ED-STATEMENTS-Q-04",
          "type": "RECONCILIATION",
          "prompt": "完成资产负债表、利润表和净资产变动表勾稽。",
          "reconciliation": {
            "fields": [
              {
                "fieldId": "asset-balance-diff",
                "label": "资产总额 - 负债 - 期末净资产",
                "kind": "NUMBER",
                "formula": "34,000,000 - 400,000 - 33,600,000",
                "placeholder": "输入差额",
                "precision": 2,
                "tolerance": 0.01
              },
              {
                "fieldId": "profit-diff",
                "label": "收入 - 费用 - 本期利润",
                "kind": "NUMBER",
                "formula": "2,200,000 - 400,000 - 1,800,000",
                "placeholder": "输入差额",
                "precision": 2,
                "tolerance": 0.01
              },
              {
                "fieldId": "rollforward-diff",
                "label": "期初净资产 + 申购 + 利润 - 期末净资产",
                "kind": "NUMBER",
                "formula": "31,000,000 + 800,000 + 1,800,000 - 33,600,000",
                "placeholder": "输入差额",
                "precision": 2,
                "tolerance": 0.01
              },
              {
                "fieldId": "closure-status",
                "label": "三表闭合状态",
                "kind": "SELECT",
                "formula": "资产负债表、利润表、净资产变动表期末结果一致",
                "placeholder": "选择状态",
                "options": [
                  {
                    "optionId": "BALANCED",
                    "text": "闭合"
                  },
                  {
                    "optionId": "UNBALANCED",
                    "text": "未闭合"
                  }
                ]
              }
            ]
          },
          "answer": [
            "0",
            "0",
            "0",
            "BALANCED"
          ],
          "explanation": "三条差额分别为零，且期末净资产从资产负债表和净资产变动表两条路径得到同一结果。",
          "hints": [
            "主表平衡要分别保留三条差额。"
          ]
        },
        {
          "questionId": "ACC-ED-STATEMENTS-Q-05",
          "type": "SHORT_TEXT",
          "prompt": "用一句话说明为什么主表复核不能只做字段映射。",
          "textInput": {
            "label": "跨表闭环结论",
            "placeholder": "写出资产、利润和净资产变动至少两条计算链"
          },
          "answer": [
            "资产",
            "负债",
            "利润",
            "净资产",
            "跨表",
            "闭合"
          ],
          "explanation": "字段映射只是取数起点，必须用资产减负债、收入减费用和净资产变动链完成闭环。",
          "hints": [
            "至少写出一个资产链和一个净资产变动链。"
          ]
        }
      ]
    },
