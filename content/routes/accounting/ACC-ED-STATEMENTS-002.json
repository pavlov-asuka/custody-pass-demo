{
  "routeId": "ACC-ED-STATEMENTS-002",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "财务主表与净资产跨表闭环",
  "summary": "沿用已锁定的年报/中报任务口径，读取账簿、估值表、资产负债表、利润表和净资产变动表，完成资产、负债、利润及期末净资产的连续计算和跨表闭合。",
  "estimatedMinutes": 60,
  "objectives": [
    "从账簿和估值结果读取资产、负债、收入、费用及净资产变动字段，建立来源到主表的对应",
    "分别复算资产总额、负债总额、收入/费用合计和本期利润，不把字段映射当作闭环",
    "用资产负债表、利润表和净资产变动表共同验证期末净资产，并形成正常业务结论"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ED-STATEMENTS-KC-01",
          "type": "FLOW",
          "title": "先把账簿和估值结果送入主表",
          "conclusion": "资产负债表和利润表的每个合计都必须能回到账簿或估值资料的分项，主表之间使用同一报告期间和期末口径。",
          "items": [
            "确认账簿、估值表和三张主表属于同一产品、期间和截止日",
            "资产负债表先做资产、负债和净资产分项",
            "利润表分别取收入和费用，不把利润直接当作输入",
            "净资产变动表读取期初、申购/赎回、分红和本期利润"
          ]
        },
        {
          "cardId": "ED-STATEMENTS-KC-02",
          "type": "CATEGORIES",
          "title": "主表合计要有独立算式",
          "conclusion": "资产总额、负债总额、收入总额、费用总额和本期利润各自复算后，才能进入跨表勾稽。",
          "items": [
            "资产总额 = 现金 + 交易性资产 + 其他资产",
            "负债总额 = 管理人报酬应付 + 托管费应付 + 清算款应付 + 其他负债",
            "本期利润 = 收入总额 - 费用总额",
            "资产总额 - 负债总额 = 期末净资产"
          ]
        },
        {
          "cardId": "ED-STATEMENTS-KC-03",
          "type": "KEY_POINT",
          "title": "净资产闭环必须跨三张表",
          "conclusion": "期末净资产既要等于资产负债表资产减负债，也要等于期初净资产加申购/赎回、分红和本期利润的变动链。",
          "items": [
            "期初净资产与净资产变动表同期间",
            "申购、赎回和分红保留正负方向",
            "期末实收基金和未分配利润仍要回到期末净资产",
            "某一张表平衡不能替代另外两张表的勾稽"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "远岚基金的主表复核人员",
        "product": "远岚基金（示范合成产品）",
        "date": "2026-06-30",
        "purpose": "用不同于综合实务的正常数据，从账簿/估值到三张财务主表完成期末净资产闭环。",
        "facts": [
          "资产分项为现金 2,400,000.00、估值资产 31,000,000.00、其他资产 600,000.00，负债合计 400,000.00。",
          "收入合计 2,200,000.00，费用合计 400,000.00，本期利润 1,800,000.00。",
          "期初净资产 31,000,000.00，净申购 800,000.00，无赎回/分红，期末净资产 33,600,000.00。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "确认账簿、估值表、资产负债表、利润表和净资产变动表均为远岚基金 2026-06-30 口径",
          "reason": "跨表计算的前提是对象、期间和截止日一致。"
        },
        {
          "order": 2,
          "action": "复算资产总额 2,400,000 + 31,000,000 + 600,000 = 34,000,000，减负债 400,000 得净资产 33,600,000",
          "reason": "资产负债表不能只读期末净资产字段，必须做资产和负债两边的算式。"
        },
        {
          "order": 3,
          "action": "复算利润 2,200,000 - 400,000 = 1,800,000",
          "reason": "利润表收入、费用合计要能回到本期利润。"
        },
        {
          "order": 4,
          "action": "复算净资产变动 31,000,000 + 800,000 + 1,800,000 = 33,600,000，并填入期末实收基金 31,800,000、未分配利润 1,800,000",
          "reason": "净资产变动表同时承接资金变动和利润结果，不能只做主表字段复制。"
        },
        {
          "order": 5,
          "action": "确认资产负债表、利润表和净资产变动表的期末净资产均为 33,600,000，记录 BALANCED",
          "reason": "正常结论由资产、负债、利润和净资产变动四条数字链共同支持。"
        }
      ],
      "summary": "锁定同期间资料 → 复算资产/负债 → 复算收入/费用/利润 → 复算净资产变动和表内局部 → 三表闭合"
    },
    "BASIC_PRACTICE": {
      "questions": [
        {
          "questionId": "ACC-ED-STATEMENTS-Q-01",
          "type": "FIELD_MAP",
