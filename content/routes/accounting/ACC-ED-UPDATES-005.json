{
  "routeId": "ACC-ED-UPDATES-005",
  "contentVersion": "1.0.0",
  "line": "ACCOUNTING",
  "title": "更新招募与产品资料概要版本、截止日和数值复核",
  "summary": "在批准的正常更新资料包内识别当前稿、上一稿和变更公告，定位版本差异，核对内容/财务/业绩三类截止日、托管人和最新定期报告数据，复算一项最新报告数字及综合运作费率/期间费用，并以局部对比底稿和附件范围结论闭合复核。",
  "estimatedMinutes": 65,
  "objectives": [
    "从当前稿、上一稿、变更公告和批准资料表读取版本字段，定位托管人/费率等实际差异与未变字段",
    "按内容截止日大于等于财务数据截止日大于等于业绩数据截止日的题面快照，核对托管人和最新公开季报来源",
    "独立复算最新报告单位净值以及综合运作费率/期间费用，完成局部对比底稿、跨来源勾稽和附件范围短结论",
    "把材料中的历史版本表、文件名年份、权限和回复/签送流程作为证据限制或题面边界，不当作永久规则"
  ],
  "steps": {
    "KNOWLEDGE_CARD": {
      "cards": [
        {
          "cardId": "ED-UPDATES-KC-01",
          "type": "FLOW",
          "title": "先锁定当前稿、上一稿和变更公告",
          "conclusion": "更新复核的第一步是建立当前稿、上一稿、变更公告和附件对象的身份链；只对同一产品、同一更新批次的文件做差异判断。",
          "items": [
            "读取当前稿和上一稿的版本/更新次序及文件名",
            "确认批准变更公告覆盖本次差异",
            "把基金代码、合同生效日等未变字段与实际变更字段分开",
            "文件名年份只作线索，不能替代正文版本表和题面批准快照"
          ]
        },
        {
          "cardId": "ED-UPDATES-KC-02",
          "type": "CATEGORIES",
          "title": "三类截止日和最新报告来源要分层",
          "conclusion": "内容截止日、财务数据截止日和业绩数据截止日分别取数并验证顺序；最新投资组合和业绩数据必须回到截至更新截止日已公开的最新定期报告。",
          "items": [
            "内容截止日 ≥ 财务数据截止日 ≥ 业绩数据截止日",
            "财务数据截止日与投资组合报告截止日一致",
            "业绩数据截止日与基金业绩章节截止日一致",
            "托管人字段按题面批准复核意见日期对应的最新来源核对"
          ]
        },
        {
          "cardId": "ED-UPDATES-KC-03",
          "type": "KEY_POINT",
          "title": "费率、数值和附件范围都要闭合",
          "conclusion": "最新报告数字和产品资料概要费率均需独立复算；附件范围要明确当前稿、上一稿、公告、最新报告和托管人来源，结论只针对列示附件。",
          "items": [
            "最新单位净值 = 最新报告期末净资产 ÷ 期末份额",
            "综合运作费率 = 管理费率 + 托管费率 + 销售服务费率 + 其他费用费率",
            "题面批准的平均资产、天数和日计数分母只用于本案例期间费用估算",
            "不把回复、签送、权限或后续再次改稿流程当作数值复核结果"
          ]
        }
      ]
    },
    "DEMONSTRATION": {
      "scenario": {
        "role": "青屿基金的更新招募与产品资料概要复核人员",
        "product": "青屿基金（示范合成产品）",
        "date": "2026-04-10",
        "purpose": "使用不同于综合实务的正常更新资料，完成版本差异、截止日、最新报告净值、综合费率和附件范围复核。",
        "facts": [
          "当前稿为 CASE-DEMO-CURRENT-招募-2026-第1次更新.docx/产品资料概要，上一稿为 CASE-DEMO-PREV-招募-2025-第3次更新.docx/产品资料概要，变更公告为 CASE-DEMO-ANN-2026-03-15.pdf。",
          "当前托管人为案例托管人丙（脱敏），上一稿为案例托管人甲（脱敏）；管理费率由 1.00% 变为 0.90%，托管费率由 0.20% 变为 0.18%，其余两项费率不变。",
          "内容截止日 2026-04-05，财务数据截止日 2026-03-31，业绩数据截止日 2026-03-31；最新季报期末净资产 82,000,000.00 元、期末份额 80,000,000 份。",
          "最新单位净值 = 82,000,000 ÷ 80,000,000 = 1.025000；综合运作费率 = 0.90% + 0.18% + 0.15% + 0.07% = 1.30%。",
          "批准期间费用估算参数为平均资产 80,000,000.00 元、90 天、日计数分母 365，估算费用 80,000,000 × 1.30% × 90 ÷ 365 = 256,438.36 元；附件集完整，结论正常。"
        ]
      },
      "steps": [
        {
          "order": 1,
          "action": "按文件名、版本字段和变更公告识别青屿当前稿、上一稿及公告，并把托管人/费率变化与基金代码未变化分开",
          "reason": "版本身份错误会把上一稿或其他批次的差异带入本次更新。"
        },
        {
          "order": 2,
          "action": "核对内容截止日 2026-04-05 ≥ 财务数据截止日 2026-03-31 ≥ 业绩数据截止日 2026-03-31，并锁定托管人丙为当前来源",
          "reason": "三类截止日分别承载文字、财务和业绩数据，不能只记录一个日期。"
        },
        {
          "order": 3,
          "action": "复算最新季报单位净值 82,000,000 ÷ 80,000,000 = 1.025000",
          "reason": "最新报告数字必须回到净资产和份额原始字段，不直接照抄概要显示值。"
        },
        {
          "order": 4,
          "action": "复算综合运作费率 0.90% + 0.18% + 0.15% + 0.07% = 1.30%，并按批准参数估算期间费用 256,438.36 元",
          "reason": "费率变更要由当前稿字段独立重算，期间费用估算只适用本案例批准参数。"
        },
        {
          "order": 5,
          "action": "把当前/上一稿差异、三类截止日、托管人、最新季报、费率和完整附件集填入对比底稿，形成正常复核结论",
          "reason": "结论应说明复核对象和数字/附件闭合状态，不以逐段比对或签送动作代替业务结果。"
        }
      ],
      "summary": "识别三类版本资料 → 定位差异 → 核对截止日/托管人/最新报告 → 复算净值和费率/费用 → 形成附件范围结论"
    },
